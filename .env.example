# Lattice Scout — every variable with a safe default. Copy to .env (git-ignored).
APP_ENV=dev                       # test | dev | prod
DATABASE_URL=postgresql+psycopg://scout:scout@localhost:5432/scout
TEST_DATABASE_URL=postgresql+psycopg://scout:scout@localhost:5432/scout_test

# Backends (fakes by default; no network needed)
LLM_BACKEND=fake                  # fake | llm_router | openai_direct
LITERATURE_BACKEND=fixtures       # fixtures | openalex
STORAGE_BACKEND=local             # local | supabase
EMAIL_PROVIDER=console            # console | resend
AUTH_MODE=dev                     # dev | supabase  (dev is refused when APP_ENV=prod)
LOCAL_STORAGE_DIR=var/storage
AUDIT_HASH_KEY=dev-audit-hash-key-change-me   # HMAC key for the erased-account tombstone (required when APP_ENV=prod)
ERASURE_SECOND_PASS_MINUTES=15   # second sweep after an account deletion

# Supabase (deployed environments only)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=

# LLM
OPENAI_API_KEY=
LLM_ROUTER_CONFIG=config/llm_router.yaml
LLM_ROUTER_SOURCE=                # e.g. git+https://github.com/fredbuildsai/llmrouter-free@v0.1.0
# Confidential data rule (docs/adr/016). Vault documents and anything derived from them go only to deployments
# marked `authorized: true` in llm_router.yaml whose provider is listed here. With none authorized (the default)
# runs, matching and ingestion still go ahead on published data only and Scout says so. Old LLM_VAULT_* names still work.
LLM_CONFIDENTIAL_AUTHORIZED_PROVIDERS=   # comma list, e.g. mistral,groq
LLM_FAKE_CONFIDENTIAL_ALLOWED=true   # LLM_BACKEND=fake only: false emulates "no authorized provider" (demo, tests)
LLM_CONFIDENTIAL_ALLOW_ANY_PROVIDER=false  # explicit waiver: confidential data may go to any configured deployment (not recommended)
LLM_MODEL_REASONING=reasoning
LLM_MODEL_FAST=fast
LLM_PRICE_TABLE=config/llm_prices.yaml

# Literature
OPENALEX_API_KEY=
OPENALEX_MAILTO=
LAUNCH_FIELD=bio-based-materials

# Budgets and matching
RUN_BUDGET_USD=1.50
RUN_MAX_OPENALEX_CALLS=400
RUN_MAX_CORPUS=2500
RUN_MAX_PER_DAY=5
ACCOUNT_DAILY_BUDGET_USD=5.00
GLOBAL_DAILY_LLM_BUDGET_USD=20.00   # all users together; at the cap new runs pause until the next UTC day
GLOBAL_DAILY_OPENALEX_BUDGET_USD=5.00
GLOBAL_DAILY_LLM_CALLS=1500      # provider requests per UTC day (free models cost 0 USD, so USD never trips); 0 = off
UPLOAD_MAX_PER_DAY=30   # per account; 0 = unlimited
RUN_LLM_CONCURRENCY=3
RUN_OPENALEX_CONCURRENCY=4
RUN_ANALYSE_MAX_CALLS=2
RUN_MAX_RESOLVE=20
RUN_STALL_MINUTES=20
RUN_MAX_EXECUTIONS=8
FIELDS_CONFIG=config/fields.yaml
MATCH_MAX_OPEN_PER_WEEK=3
MATCH_EXPIRY_DAYS=14
MATCH_EXCLUDE_COAUTHORS=true
MATCH_NON_MEMBERS=false
RETENTION_POLICY=user_choice      # keep | discard | user_choice

# Vault
VAULT_UPLOAD_WARNING=true          # warn users not to upload confidential material (DECISIONS 130); false hides it

# Observability
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_MONTHS=13   # older monthly partitions of analytics_event, llm_call and external_call are dropped
ANALYTICS_FLUSH_MS=2000
ANALYTICS_RETENTION_DAYS=395
USAGE_FLUSH_MS=2000
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER_ARG=0.2

# Frontend (Vite)
VITE_AUTH_MODE=dev
VITE_API_URL=http://localhost:8000
# Only with VITE_AUTH_MODE=supabase. Vite reads frontend/.env, so copy these there.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Email / worker
EMAIL_API_KEY=
EMAIL_FROM=
APP_BASE_URL=http://localhost:5173   # links in e-mails
WORKER_POLL_INTERVAL_MS=1000
JOB_LEASE_SECONDS=300

# Vault (document upload and ingestion)
VAULT_MAX_BYTES=26214400
VAULT_MAX_PAGES=300
VAULT_MAX_TEXT_CHARS=720000
VAULT_EXTRACT_TIMEOUT_S=60
VAULT_EXTRACT_MEMORY_MB=1024
VAULT_MAX_DOCUMENTS=50
INSIGHT_FULL_MAX_CHARS=120000
INSIGHT_SLICE_CHARS=60000
INSIGHT_MAP_CONCURRENCY=3
SUPABASE_STORAGE_BUCKET=vault

# LLM adapters / buffers
LLM_FIXTURES_DIR=backend/tests/fixtures/llm
PROMPTS_DIR=prompts
LLM_MAX_CONCURRENCY=8
LLM_ROUTER_ALLOW_PAID=false   # free tiers only (OpenRouter, Groq, Mistral)
LLM_ROUTER_MAX_USD_PER_DAY=5
ANALYTICS_QUEUE_MAX=20000
USAGE_QUEUE_MAX=10000
OTEL_SERVICE_NAME=
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Embeddings are off in the MVP (ADR-005). Leave unset.
# EMBEDDING_MODEL=
# EMBEDDING_DIM=
DEV_KEYS_DIR=var/dev-keys
DEV_ISSUER=http://localhost:8000/dev-auth
LITERATURE_FIXTURES_DIR=tests/fixtures/openalex
ADMIN_CLAIMS_SHOW_VAULT_QUOTES=false
METHODS_CONFIG=config/methods.yaml
MATCH_COOLDOWN_DAYS=180
MATCH_MIN_SCORE=0.11
MATCH_EXCLUDE_SAME_GROUP=true
MATCH_MAX_EXPLAINS_PER_RUN=200
MATCH_NIGHTLY_UTC_HOUR=2
MATCH_ALPHA=1.0
MATCH_BETA=1.5

# Provider keys read by llm-router (names come from config/llm_router.yaml; any one is enough)
OPENROUTER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
